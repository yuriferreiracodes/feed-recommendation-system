# Application environment: development | staging | production
APP_ENV=development

# SQLAlchemy connection string for MySQL (host "db" is the compose service name)
DATABASE_URL=mysql+pymysql://root:root@db:3306/feedapp

# Redis connection string used for caching and feed ranking
REDIS_URL=redis://redis:6379/0

# Elasticsearch endpoint used for content indexing and search
ELASTICSEARCH_URL=http://elasticsearch:9200

# Secret used to sign tokens/sessions — override with a strong value outside dev
SECRET_KEY=change-me-in-production
