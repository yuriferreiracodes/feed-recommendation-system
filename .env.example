# Application environment: development | staging | production
APP_ENV=development

# SQLAlchemy connection string for MySQL (host "db" is the compose service name)
DATABASE_URL=mysql+pymysql://root:root@db:3306/feedapp

# Redis connection string used for caching and feed ranking
REDIS_URL=redis://redis:6379/0

# Elasticsearch endpoint used for content indexing and search
ELASTICSEARCH_URL=http://elasticsearch:9200

# MinIO object storage: host:port of the S3 API (no scheme), credentials, bucket
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=feed-media
MINIO_SECURE=false

# Image upload limits: max accepted file size and thumbnail longest side (px)
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_THUMBNAIL_MAX_PX=480

# Secret used to sign tokens/sessions — override with a strong value outside dev
SECRET_KEY=change-me-in-production
